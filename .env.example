# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Admin Telegram IDlari (bir nechta bo'lsa vergul bilan ajrating: 12345678,87654321)
ADMIN_IDS=123456789

# Asosiy kino saqlanadigan kanal IDsi (ixtiyoriy, masalan: -1001234567890)
SOURCE_CHANNEL_ID=-1001234567890

# SQLite ma'lumotlar bazasi fayli nomi (ixtiyoriy, standart: minotv.db)
DB_PATH=minotv.db
